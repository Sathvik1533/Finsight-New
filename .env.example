# ── Supabase ──────────────────────────────────────────────────────
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── FastAPI Backend ───────────────────────────────────────────────
# Local: http://localhost:8000  |  Production: Railway URL
FASTAPI_INTERNAL_URL=http://localhost:8000
FASTAPI_SECRET_KEY=your-secret-key-minimum-32-characters-long

# ── AI APIs ───────────────────────────────────────────────────────
# NVIDIA NIM (OCR): https://build.nvidia.com
NVIDIA_NIM_API_KEY=nvapi-your-key-here

# Groq (categorization): https://console.groq.com
GROQ_API_KEY=
