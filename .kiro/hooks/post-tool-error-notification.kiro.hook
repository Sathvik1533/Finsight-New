{
  "enabled": true,
  "name": "Tool Error Notification",
  "description": "Triggers audio notification when any tool execution fails",
  "version": "1",
  "when": {
    "type": "postToolUse",
    "toolTypes": [
      "*"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "bash .claude/hooks/notification.sh error"
  },
  "workspaceFolderName": "Finsight New ",
  "shortName": "post-tool-error-notification"
}